# Optional: blank uses Cloud Shell's source-region profile, or DEFAULT locally.
# Local runs use an API-key profile in ~/.oci/config; Cloud Shell uses its login.
OCI_PROFILE=

# Use two different regions in the same tenancy.
SOURCE_REGION=me-dubai-1
DESTINATION_REGION=me-abudhabi-1

# Required: compartment containing the source VCN and its network resources.
SOURCE_COMPARTMENT_OCID=ocid1.compartment.oc1..REPLACE_ME

# Optional: blank uses SOURCE_COMPARTMENT_OCID.
DESTINATION_COMPARTMENT_OCID=

# Optional only when the source compartment contains exactly one VCN.
SOURCE_VCN_OCID=

# Optional: blank preserves the source VCN display name.
DESTINATION_VCN_NAME=

# Opt in: prepare networking, exclude DRG connectivity, and defer all private-IP
# routes. Deploy appliances and allocate their private IPs manually.
# The scripts do not reserve private IPs.
# Omit or set false for strict copy validation. Keep unchanged after first plan.
PREPARE_NETWORK_ONLY=true

# Exact OCI Terraform provider version used for destination plans.
OCI_PROVIDER_VERSION=9.2.0
